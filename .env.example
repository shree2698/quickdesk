# ==============================================================================
# QuickDesk Environment Configuration Template (.env.example)
# Copy this file to .env before running the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schemDATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (use a long random string in production)
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"

# ------------------------------------------------------------------------------
# 3. AI & LLM Provider Keys
# ------------------------------------------------------------------------------
# Google Gemini API key for RAG vector embeddings & ticket auto-classification
# Get a free key at: https://aistudio.google.com/
# AI & LLM Provider Configuration
# Supported AI_PROVIDER values: "google" | "grok" | "openrouter" | "openai"
AI_PROVIDER="google"
AI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# Provider API Keys
GEMINI_API_KEY="your-google-gemini-api-key-here"
GROK_API_KEY="your-grok-api-key-here"
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# ------------------------------------------------------------------------------
# 4. Server & Application Ports / URLs
# ------------------------------------------------------------------------------
# Backend HTTP server port (NestJS)
PORT=5000

# Frontend origin URL for CORS policy
FRONTEND_URL="http://localhost:3000"

# Public backend API URL
BACKEND_URL="http://localhost:5000"

# Socket.io WebSocket server URL
SOCKET_URL="http://localhost:5000"

# Base URL for static file uploads (only relative filename stored in DB)
UPLOAD_BASE_URL="http://localhost:5000/uploads/knowledge-base"
localhost:5000/uploads/knowledge-base"

t:5000/uploads/knowledge-base"

