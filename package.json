{
  "name": "quickdesk",
  "version": "1.0.0",
  "private": true,
  "description": "QuickDesk - Helpdesk System with AI-powered RAG",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start:prod --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspace=backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npx prisma generate --config=backend/prisma.config.ts",
    "prisma:migrate": "npx prisma migrate dev --config=backend/prisma.config.ts",
    "prisma:push": "npx prisma db push --config=backend/prisma.config.ts",
    "prisma:reset": "npx prisma migrate reset --force --config=backend/prisma.config.ts",
    "db:seed": "npx tsx backend/prisma/seed.ts",
    "db:reset": "npm run prisma:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
