# ==============================================================================
# QuickDesk Environment Configuration Template (.env.example)
# Copy this file to .env before running the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickdesk?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (use a long random string in production)
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"

# ------------------------------------------------------------------------------
# 3. AI & LLM Provider Keys & Models
#   #### 1. Google Gemini (Default)

#     AI_PROVIDER="google"
#     AI_MODEL="gemini-2.0-flash"
#     EMBEDDING_MODEL="gemini-embedding-001"
#     GEMINI_API_KEY="AIzaSy..."

#   #### 2. Grok (xAI)

#     AI_PROVIDER="grok"
#     AI_MODEL="grok-2-latest"
#     EMBEDDING_MODEL="text-embedding-3-small"
#     GROK_API_KEY="xai-..."

#   #### 3. OpenRouter (Access 100+ LLMs via 1 key)

#     AI_PROVIDER="openrouter"
#     AI_MODEL="google/gemini-2.0-flash-001"   # Or "anthropic/claude-3.5-sonnet", "meta-llama/llama-3.3-70b-instruct"
#     EMBEDDING_MODEL="text-embedding-3-small"
#     OPENROUTER_API_KEY="sk-or-..."

#   #### 4. OpenAI

#     AI_PROVIDER="openai"
#     AI_MODEL="gpt-4o-mini"
#     EMBEDDING_MODEL="text-embedding-3-small"
#     OPENAI_API_KEY="sk-proj-..."
#     ──────
# ------------------------------------------------------------------------------
AI_PROVIDER="google"
AI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 4. Server & Application Ports / URLs
# ------------------------------------------------------------------------------
# Backend HTTP server port (NestJS)
PORT=5000

# Frontend origin URL for CORS policy
FRONTEND_URL="http://localhost:3000"

# Public backend API URL
BACKEND_URL="http://localhost:5000"

# Socket.io WebSocket server URL
SOCKET_URL="http://localhost:5000"
